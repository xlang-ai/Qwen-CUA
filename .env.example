# OpenAI-compatible Qwen CUA endpoint. The API key never leaves the runner.
QWEN_CUA_BASE_URL=http://127.0.0.1:8000/v1
QWEN_CUA_API_KEY=dummy
QWEN_CUA_MODELS=Qwen/Qwen-CUA
QWEN_CUA_DEFAULT_MODEL=Qwen/Qwen-CUA

# Model defaults aligned with the release evaluation harness.
QWEN_CUA_ENABLE_THINKING=true
QWEN_CUA_MAX_TOKENS=32768
QWEN_CUA_TEMPERATURE=0.6
QWEN_CUA_TOP_P=0.95
QWEN_CUA_TOP_K=20
QWEN_CUA_MODEL_RETRIES=3

# Runner and browser.
QWEN_CUA_HOST=127.0.0.1
QWEN_CUA_PORT=4001
QWEN_CUA_WEB_ORIGIN=http://127.0.0.1:3000
QWEN_CUA_DEFAULT_MAX_TURNS=50
QWEN_CUA_HISTORY_N=50
QWEN_CUA_IMAGE_MAX=20
QWEN_CUA_MAX_CONCURRENT_RUNS=1
QWEN_CUA_VIEWPORT_WIDTH=1920
QWEN_CUA_VIEWPORT_HEIGHT=1080
QWEN_CUA_MAX_UPLOAD_BYTES=10485760

# Custom URLs resolving to private/loopback addresses are blocked by default.
QWEN_CUA_ALLOW_PRIVATE_URLS=false

# Browser-visible runner URL used by the Next.js client.
NEXT_PUBLIC_RUNNER_BASE_URL=http://127.0.0.1:4001

